{
  "name": "ppr-tool",
  "version": "0.1.0",
  "description": "Publisher CLI for the private package registry: validate, stage, verify and commit multi-ecosystem releases.",
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/private-package-registry/ppr-tool.git" },
  "type": "module",
  "engines": { "node": ">=22" },
  "bin": { "ppr-tool": "dist/ppr-tool.mjs" },
  "files": ["dist", "release.schema.json"],
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "dependencies": {
    "fast-xml-parser": "5.11.1",
    "fflate": "0.8.3",
    "smol-toml": "1.8.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  }
}
